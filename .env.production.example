# 本番環境（GCP e2-micro）用の環境変数テンプレート。
# 実値を入れて .env としてコピーすること（.env はコミットしない）。

# Django
SECRET_KEY=__CHANGE_ME__
DJANGO_ENV=production
DEBUG=0
ALLOWED_HOSTS=<sub>.duckdns.org
CORS_ALLOWED_ORIGINS=https://<sub>.duckdns.org
CSRF_TRUSTED_ORIGINS=https://<sub>.duckdns.org

# PostgreSQL（コンテナ同居）
POSTGRES_DB=dishboard
POSTGRES_USER=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__
DB_HOST=db
DB_PORT=5432

# MCP サーバ（Claude 連携）
# Claude のコネクタに登録する URL と**完全一致**させること（パス込み）。
# OAuth の issuer もこの URL のオリジンから導出される。
MCP_RESOURCE_URL=https://<your-subdomain>.duckdns.org/mcp

# Azure AI Vision (OCR)
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=__CHANGE_ME__
