# 本番環境（GCP e2-micro）用の環境変数テンプレート。
# 実値を入れて .env としてコピーすること（.env はコミットしない）。

# Django
SECRET_KEY=__CHANGE_ME__
DJANGO_ENV=production
DEBUG=0
# nginx 設定へ注入するドメイン（ADR #25）。テンプレートを sed で書き換えないこと
DISHBOARD_DOMAIN=<sub>.duckdns.org
DISHBOARD_AUTH_DOMAIN=<auth-sub>.duckdns.org

# OAuth認可用サブドメイン（<auth-sub>.duckdns.org）もカンマ区切りで含めること。
# CORS_ALLOWED_ORIGINS はSPAのAPI呼び出し用なので認可用サブドメインは不要
ALLOWED_HOSTS=<sub>.duckdns.org,<auth-sub>.duckdns.org
CORS_ALLOWED_ORIGINS=https://<sub>.duckdns.org
CSRF_TRUSTED_ORIGINS=https://<sub>.duckdns.org,https://<auth-sub>.duckdns.org
# Google Cloud Console の「ウェブ アプリケーション」OAuthクライアントID。
# 承認済みJavaScript生成元にPWAのオリジンを登録すること。
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# PostgreSQL（コンテナ同居）
POSTGRES_DB=dishboard
POSTGRES_USER=__CHANGE_ME__
POSTGRES_PASSWORD=__CHANGE_ME__
DB_HOST=db
DB_PORT=5432

# MCP サーバ（Claude 連携）
# Claude のコネクタに登録する URL と**完全一致**させること（パス込み）。
MCP_RESOURCE_URL=https://<your-subdomain>.duckdns.org/mcp

# 認可サーバ（OAuth ログイン画面・トークン発行）の issuer。
# PWA を配信しているドメインと**別のサブドメイン**にすること。同一だと、
# インストール済みPWAへのリンクをAndroidが横取りし、スマホのClaudeアプリから
# ログイン画面に到達できなくなる（ADR #26）。このサブドメインにはPWAを配布しない
OAUTH2_ISSUER_URL=https://<your-auth-subdomain>.duckdns.org

# Azure AI Vision (OCR)
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=__CHANGE_ME__
